# BharatSatya Environment Configuration Template
PORT=5000
NODE_ENV=development
# PostgreSQL is used for local development and deployment. DATABASE_URL may be a
# provider's pooled URL; DIRECT_URL is used by Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bharatsatya?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/bharatsatya?schema=public"
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
UPLOAD_DIR="./uploads"
DOCUMENT_STORAGE_PROVIDER=local
# In production select the S3-compatible adapter and configure all storage values below.
OBJECT_STORAGE_ENDPOINT=https://object-storage.example.invalid
OBJECT_STORAGE_BUCKET=bharatsatya-private-documents
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=replace_with_storage_access_key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace_with_storage_secret
OBJECT_STORAGE_FORCE_PATH_STYLE=true
# Set true only after verifying the bucket blocks anonymous/public reads.
OBJECT_STORAGE_PRIVATE_BUCKET_CONFIRMED=false
OCR_TESSERACT_LANG="eng"
OCR_SERVICE_URL=https://private-ocr.example.invalid
OCR_SERVICE_TOKEN=replace_with_private_ocr_service_token
OCR_SERVICE_TIMEOUT_MS=90000
ALLOW_SYNTHETIC_SEED=false
DEMO_ACCOUNTS_MODE=disabled
DEMO_ADMIN_PASSWORD=replace_with_local_demo_password
DEMO_REVIEWER_PASSWORD=replace_with_local_demo_password
DEMO_APPLICANT_PASSWORD=replace_with_local_demo_password
CORS_ORIGIN="http://localhost:5173"
