# Set to exactly "true" only for a public, frontend-only synthetic demonstration build.
# This enables local browser data and presentation-only roles; it is not authentication.
VITE_DEMO_MODE=true

# Optional, development-only entry to synthetic workspaces. Requires VITE_DEMO_MODE=true.
# Vite development server only; this is not real authentication.
VITE_DEMO_ACCESS=false

# Public OAuth web client ID used by Google Identity Services.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
